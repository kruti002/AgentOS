# AgentOS environment configuration template
# Copy this file to ".env" and fill in your real values.
#   PowerShell:  Copy-Item .env.example .env
# The real .env is gitignored so your key is never committed.

# FreeLLMAPI router (OpenAI-compatible endpoint).
# Default is the local FreeLLMAPI desktop app / Docker container.
FREELLM_BASE_URL=http://localhost:3001/v1

# Your unified FreeLLMAPI key (starts with "freellmapi-").
# Get it from the FreeLLMAPI dashboard Keys page header or the tray popover.
FREELLM_API_KEY=freellmapi-your-unified-key-here

# Model to request from the router. "auto" lets the router pick a healthy free model.
# You can also use "auto:fast", "auto:smart", a named profile, or a specific model id.
AGENTOS_MODEL=auto

# --- API hardening (all optional; safe dev defaults when unset) ---
# Bearer token required on /api requests. Leave empty to disable auth (dev).
AGENTOS_AUTH_TOKEN=
# Comma-separated allowed CORS origins, or "*" for all (dev default).
AGENTOS_ALLOWED_ORIGINS=*
# Fixed-window rate limit per client IP.
AGENTOS_RATE_LIMIT=120
AGENTOS_RATE_WINDOW=60

# --- Observability (optional) ---
# OTLP HTTP endpoint for exporting traces (e.g. http://localhost:4318/v1/traces).
# Leave empty to keep traces in-memory only. Requires opentelemetry-exporter-otlp.
AGENTOS_OTLP_ENDPOINT=
# Embedding model for RAG memory (used only if a provider serving it is configured).
AGENTOS_EMBEDDING_MODEL=text-embedding-3-small
